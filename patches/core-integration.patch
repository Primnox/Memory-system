+def _m012_memory_topic_and_kind(conn: sqlite3.Connection) -> None:
+    """v11 -> v12: room for what a memory is about and what sort it is.
+
+    Plain ADD COLUMNs, no CHECK constraint, so no rebuild. Rows are NOT
+    classified here: that is deterministic Python in cognition/topics.py, run
