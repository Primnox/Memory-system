+-- backfill_topics() asks "is anything unclassified?" before every search and
+-- write. Empty in a steady state, so the answer costs nothing; without it the
+-- answer was a scan of the whole table each time.
+CREATE INDEX IF NOT EXISTS idx_memories_unclassified
+    ON memories(id) WHERE topic IS NULL;
+
+-- The memory service reads every forgotten row's successor link to decide what
+-- stands in for a retired fact (memory/service.py::_successor), on each scan.
+-- Few rows, so as a covering partial index that read never touches the table.
+CREATE INDEX IF NOT EXISTS idx_memories_forgotten
+    ON memories(id, superseded_by) WHERE deleted_at IS NOT NULL;
+
+-- Every question the local model was asked about whether one memory replaces
+-- another (memory/verifier.py), with its answer. Kept to train a small local
+-- decision model; never sent anywhere. In primnox.db rather than a file beside it
+-- so the vault encrypts it with everything else it holds about the user. The texts
+-- are copied, as a forgotten memory's row is: no FK, nothing here follows a delete.
+CREATE TABLE IF NOT EXISTS memory_verifications (
+    id          INTEGER PRIMARY KEY AUTOINCREMENT,
+    ts          INTEGER NOT NULL,
+    model       TEXT    NOT NULL,
+    new_id      TEXT    NOT NULL,
+    old_id      TEXT    NOT NULL,
+    new_text    TEXT    NOT NULL,
+    old_text    TEXT    NOT NULL,
+    similarity  REAL,
+    relation    TEXT    NOT NULL,
+    confidence  REAL    NOT NULL,
+    applied     INTEGER NOT NULL DEFAULT 0,
+    ms          INTEGER
+);
+
 
